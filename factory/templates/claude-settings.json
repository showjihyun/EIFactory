{
  "permissions": {
    "allow": [
      "Bash(python scripts/factory.py new:*)",
      "Bash(python scripts/factory.py spec:*)",
      "Bash(python scripts/factory.py red:*)",
      "Bash(python scripts/factory.py verify:*)",
      "Bash(python scripts/factory.py validate:*)",
      "Bash(python scripts/factory.py merge:*)",
      "Bash(python scripts/factory.py recover:*)",
      "Bash(python scripts/factory.py block:*)",
      "Bash(python scripts/factory.py status:*)",
      "Bash(python scripts/check_red.py:*)",
      "Bash(python scripts/check_style.py:*)",
      "Bash(python scripts/verify.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push:*)",
      "Bash(python scripts/factory.py approve:*)",
      "Bash(python scripts/factory.py resume:*)",
      "Bash(python scripts/factory.py drop:*)",
      "Bash(python scripts/dispatch.py:*)",
      "Bash(python scripts/issues.py:*)",
      "Bash(python scripts/factory_settings.py set:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
